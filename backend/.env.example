# Copia este archivo como .env y rellena los valores. El .env real nunca se sube a git.

# Obligatoria. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Opcional. Sin ella se usa SQLite local (books.db). En producción, la URL de Neon.
# DATABASE_URL=postgresql://usuario:contraseña@host/basededatos?sslmode=require

# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:5173
